{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Poppins", "system-ui", "sans-serif"], "$description": "UI type" },
      "numeric": { "$value": ["Inter", "system-ui", "sans-serif"], "$description": "Dense numerics, micro labels, tabular figures" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  }
}
