{
  "radius": {
    "$type": "dimension",
    "xs": { "$value": "4px", "$description": "Inner cells inside a control: pagination pages, segmented items (Figma audit, 3 Sep 2026)" },
    "sm": { "$value": "6px", "$description": "Controls: buttons, tags, badges (the Figma corner, measured 3 Sep 2026)" },
    "md": { "$value": "8px", "$description": "Cards, panels, larger surfaces" },
    "pill": { "$value": "999px" }
  },
  "shadow": {
    "$type": "shadow",
    "card":   { "$value": { "color": "#0206230a", "offsetX": "0px", "offsetY": "1px",  "blur": "2px",  "spread": "0px" } },
    "raised": { "$value": { "color": "#02062314", "offsetX": "0px", "offsetY": "2px",  "blur": "6px",  "spread": "0px" } },
    "menu":   { "$value": { "color": "#0206232e", "offsetX": "0px", "offsetY": "8px",  "blur": "24px", "spread": "0px" } },
    "modal":  { "$value": { "color": "#02062347", "offsetX": "0px", "offsetY": "24px", "blur": "64px", "spread": "0px" } }
  }
}
